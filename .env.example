# Private SERVER configuration. Never put secrets in EXPO_PUBLIC_*.
# Production is the default. sandbox is available only for integration testing with real Square sandbox APIs.
SQUARE_ENVIRONMENT=production
PUBLIC_BASE_URL=http://172.20.1.172:3000
DATABASE_PATH=data/snap-live.sqlite
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Generate these with npm run setup:seller. One merchant per deployment.
SELLER_EMAIL=
SELLER_PASSWORD_HASH=
MAINTENANCE_SECRET=

# Required for production publishing / checkout. Enter your actual pickup and return terms.
BUSINESS_NAME=
SUPPORT_EMAIL=
PICKUP_INSTRUCTIONS=
RETURN_POLICY=
# Explicit percentage, e.g. 8.625. Set 0 only if no sales tax applies to your sales.
SALES_TAX_PERCENT=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the notification URL registered in Square. Defaults to PUBLIC_BASE_URL/api/webhooks/square.
SQUARE_WEBHOOK_URL=

# Optional features: disabled until configured; no fabricated responses.
APIFY_TOKEN=
APIFY_ACTOR_ID=ninhothedev~ebay-scraper
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
CONVEX_URL=
CONVEX_SYNC_SECRET=
