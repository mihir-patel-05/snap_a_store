# Private SERVER configuration. Never put secrets in EXPO_PUBLIC_*.
# Production is the default. sandbox is available only for integration testing with real Square sandbox APIs.
SQUARE_ENVIRONMENT=production
PUBLIC_BASE_URL=http://172.20.1.172:3000
DATABASE_PATH=data/snap-live.sqlite
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
# Enable only behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=0

# Optional legacy password account: generate with npm run setup:seller.
# MAINTENANCE_SECRET is required with either password or Google sign-in.
SELLER_EMAIL=
SELLER_PASSWORD_HASH=
MAINTENANCE_SECRET=

# Legacy password store business settings. Google sellers enter these in the app.
BUSINESS_NAME=
SUPPORT_EMAIL=
PICKUP_INSTRUCTIONS=
RETURN_POLICY=
# Explicit percentage, e.g. 8.625. Set 0 only if no sales tax applies to your sales.
SALES_TAX_PERCENT=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Must exactly match the notification URL registered in Square. Defaults to PUBLIC_BASE_URL/api/webhooks/square.
SQUARE_WEBHOOK_URL=

# Optional features: disabled until configured; no fabricated responses.
APIFY_TOKEN=
APIFY_ACTOR_ID=ninhothedev~ebay-scraper
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=
CARTESIA_MODEL=sonic-3.6
CARTESIA_VERSION=2026-08-14
CONVEX_URL=
CONVEX_SYNC_SECRET=

# Public Google signup. Register PUBLIC_BASE_URL/api/auth/google/callback as a Web OAuth redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Each Google seller connects their own Square merchant. These are application credentials.
SQUARE_APPLICATION_ID=
SQUARE_APPLICATION_SECRET=
# 32 random bytes encoded as 64 hex characters. Preserve this key with database backups.
OAUTH_ENCRYPTION_KEY=
